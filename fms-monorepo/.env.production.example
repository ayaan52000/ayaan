# Copy to .env.production, replace every REQUIRED/CHANGE_ME value, and never commit it.
FMS_DOMAIN=finance.example.com
POSTGRES_USER=fms
POSTGRES_DB=fms_db
POSTGRES_PASSWORD=REQUIRED_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://fms:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/fms_db?schema=public
JWT_SECRET=REQUIRED_RANDOM_SECRET_WITH_AT_LEAST_48_CHARACTERS
PROD_ADMIN_EMAIL=finance-head@example.com
PROD_ADMIN_NAME=Initial Finance Head
BUDGET_ENFORCEMENT=block
EMAIL_NOTIFICATIONS_ENABLED=false
