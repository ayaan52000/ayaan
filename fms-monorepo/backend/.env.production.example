NODE_ENV=production
DATABASE_URL="postgresql://FMS_USER:CHANGE_ME@postgres:5432/fms_db?schema=public"
JWT_SECRET="REQUIRED_GENERATE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS"
PORT=4000
FRONTEND_URL="https://finance.example.com"
COOKIE_SECURE="true"
BUDGET_ENFORCEMENT="block"
EMAIL_NOTIFICATIONS_ENABLED="false"
PROD_ADMIN_EMAIL="finance-head@example.com"
PROD_ADMIN_NAME="Initial Finance Head"
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="REQUIRED_PRIVATE_BUCKET_NAME"
STORAGE_ACCESS_KEY="REQUIRED_STORAGE_ACCESS_KEY"
STORAGE_SECRET_KEY="REQUIRED_STORAGE_SECRET_KEY"
STORAGE_REGION="us-east-1"
# Leave empty for AWS S3; set the S3 API endpoint for Cloudflare R2/another compatible provider.
STORAGE_ENDPOINT=""
